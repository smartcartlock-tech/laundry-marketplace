# חובה
DATABASE_URL=postgresql://user:pass@host:5432/dbname
JWT_SECRET=<random-64-hex>
# אופציונלי
PGSCHEMA=marketplace            # הפרדת סכימה כשחולקים אינסטנס Postgres עם שירות אחר
SEED_DEMO=false                 # true רק לסביבת דמו ריקה (מזריע 4 מכבסות + משתמשי דמו)
DEMO_OTP=true                   # false בפרודקשן אמיתי — אז חובה Twilio או ספק מייל
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GOOGLE_CLIENT_ID=               # אחרי הקמת OAuth client ב-Google Cloud
PORT=3000
