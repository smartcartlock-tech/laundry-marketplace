# חובה
DATABASE_URL=postgresql://user:pass@host:5432/dbname
JWT_SECRET=<random-64-hex>
# אופציונלי
PGSCHEMA=marketplace            # הפרדת סכימה כשחולקים אינסטנס Postgres עם שירות אחר
SEED_DEMO=false                 # true רק לסביבת דמו ריקה (מזריע 4 מכבסות + משתמשי דמו)
DEMO_OTP=true                   # false בפרודקשן אמיתי — אז חובה Twilio או ספק מייל
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GOOGLE_CLIENT_ID=               # אחרי הקמת OAuth client ב-Google Cloud
FIELD_ENC_KEY=                  # 32 בתים ב-base64 — הצפנת שדות רגישים (חובה בפרוד; fail-fast בלעדיו)
BACKUP_KEY=                     # 32 בתים ב-base64 — הצפנת הגיבוי היומי; נופל ל-FIELD_ENC_KEY אם ריק (test+ops: הרחבת סריקת בידוד למודול הנה"ח של K (owner-only), סקירת סודות (.env.example עם FIELD_ENC_KEY/BACKUP_KEY), תיעוד שחזור מגיבוי (docs/BACKUP-RESTORE.md), שחזור אמיתי של גיבוי מוצפן לסכימה נפרדת (src/restore.js + scripts/restore-verify.js) + בדיקה אוטומטית)
PORT=3000
